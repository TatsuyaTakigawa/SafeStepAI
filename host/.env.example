# Copy this file to .env and replace every placeholder.
WEB_PORT=8080

DB_NAME=safestep
DB_USER=safestep
DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_DB_PASSWORD
DB_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_LONG_RANDOM_ROOT_PASSWORD

APP_USERNAME=admin
# Generate with: docker run --rm php:8.3-cli php -r 'echo password_hash("YOUR_LOGIN_PASSWORD", PASSWORD_DEFAULT), PHP_EOL;'
APP_PASSWORD_HASH='REPLACE_WITH_PASSWORD_HASH'
API_KEY=REPLACE_WITH_LONG_RANDOM_API_KEY
